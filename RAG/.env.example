# ============================================================================
# LARGE FILE PROCESSING OPTIMIZATION
# ============================================================================

# ============================================================================
# GEMINI API CONFIGURATION
# ============================================================================

# Your Gemini API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (gemini-2.0-flash-exp, gemini-1.5-flash, gemini-1.5-pro, gemini-pro)
GEMINI_MODEL_NAME=gemini-2.0-flash-exp
# File size thresholds (in MB) for adaptive processing
SMALL_FILE_THRESHOLD=10
MEDIUM_FILE_THRESHOLD=30
LARGE_FILE_THRESHOLD=100

# Maximum pages to process per batch (lower = less memory, slower)
MAX_PAGES_PER_BATCH=10

# Enable/disable OCR for large files (false = cost savings)
ENABLE_OCR_FOR_LARGE_FILES=false

# Maximum pages to process for very large files (0 = no limit)
MAX_PAGES_TOTAL=100
